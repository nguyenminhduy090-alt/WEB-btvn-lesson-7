<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Book Store</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Books" asp-action="Index">BOOK STORE</a>
            <div>
                <a class="btn btn-light btn-sm" asp-controller="Books" asp-action="Create">Thêm sách</a>
            </div>
        </div>
    </nav>

    <div class="container py-4">
        @RenderBody()
    </div>

    <footer class="border-top bg-white py-3 mt-5">
        <div class="container text-muted text-center">
            Book Management MVC - ASP.NET Core
        </div>
    </footer>
</body>
</html>
